Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ClearAll", "[", "u", "]"}], ";", " ", 
     RowBox[{"genauigkeit", "=", 
      RowBox[{"-", "0.001"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fkt", ":=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"u", "[", "i", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"i", "-", "2"}], "]"}], "^", "2"}], "-", 
           RowBox[{"4", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"i", "-", "1"}], "]"}], "^", "2"}]}], "+", 
           RowBox[{"3", 
            RowBox[{
             RowBox[{"u", "[", "i", "]"}], "^", "2"}]}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}]}], ";", 
     RowBox[{
      RowBox[{"u", "[", "0", "]"}], ":=", 
      RowBox[{"u", "[", "nn", "]"}]}], ";", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"-", "1"}], "]"}], ":=", 
      RowBox[{"u", "[", 
       RowBox[{"nn", "-", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"minimierung", "=", 
      RowBox[{"Quiet", "[", 
       RowBox[{"NMinimize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"fkt", ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"0", " ", "\[LessEqual]", "  ", 
              RowBox[{"u", "[", "i", "]"}], " ", "\[LessEqual]", " ", 
              "0.999999999999"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}]}], "}"}], 
         ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"u", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}], ",", 
         RowBox[{"Method", " ", "\[Rule]", "\"\<DifferentialEvolution\>\""}], 
         ",", " ", 
         RowBox[{"WorkingPrecision", " ", "\[Rule]", " ", "30"}], ",", " ", 
         RowBox[{"AccuracyGoal", " ", "\[Rule]", "12"}], ",", " ", 
         RowBox[{"PrecisionGoal", " ", "\[Rule]", " ", "12"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"minimierung", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "genauigkeit"}], ",", 
       " ", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<For N = \>\"", ",", "nn", ",", 
         "\"\< no counterexample found\>\""}], "]"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<For N = \>\"", ",", "nn", ",", "\"\< counterexample found: \>\"",
          ",", "minimierung"}], "]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
